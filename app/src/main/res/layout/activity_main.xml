<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#000000"
    tools:context=".MainActivity">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="170dp"
        android:background="#8E44AD"
        android:padding="16dp">

        <RadioGroup
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:orientation="vertical">

            <RadioButton
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Termin"
                android:textColor="@android:color/white" />

            <RadioButton
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Numer"
                android:textColor="@android:color/white" />

            <RadioButton
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="2"
                android:textColor="@android:color/white" />
        </RadioGroup>

        <TextView
            android:layout_width="100dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical|start"
            android:layout_marginStart="16dp"
            android:background="@android:color/white"
            android:gravity="center"
            android:padding="8dp"
            android:text="Maksymilian\n Kosno"
            android:textColor="@android:color/black"
            android:textStyle="bold" />

    </FrameLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#F6B7C7"
        android:padding="20dp">

        <View
            android:layout_width="80dp"
            android:layout_height="250dp"
            android:layout_gravity="center"
            android:background="#A07A58" />

        <View
            android:layout_width="150dp"
            android:layout_height="130dp"
            android:layout_gravity="center"
            android:layout_marginBottom="120dp"
            android:layout_marginEnd="50dp"
            android:background="#38A55A" />


        <View
            android:id="@+id/view"
            android:layout_width="150dp"
            android:layout_height="130dp"
            android:layout_gravity="center"
            android:layout_marginEnd="50dp"
            android:layout_marginBottom="120dp"
            android:background="#38A55A" />

        <View
            android:layout_width="140dp"
            android:layout_height="130dp"
            android:layout_gravity="center"
            android:layout_marginBottom="60dp"
            android:layout_marginStart="30dp"
            android:background="#A6D73F" />


        <View
            android:layout_width="60dp"
            android:layout_height="20dp"
            android:layout_gravity="center"
            android:layout_marginBottom="90dp"
            android:layout_marginStart="100dp"
            android:background="#A07A58" />


        <View
            android:layout_width="25dp"
            android:layout_height="15dp"
            android:layout_gravity="center"
            android:layout_marginBottom="110dp"
            android:layout_marginStart="120dp"
            android:background="#A6D73F" />
        <View
            android:layout_width="20dp"
            android:layout_height="15dp"
            android:layout_gravity="center"
            android:layout_marginBottom="100dp"
            android:layout_marginStart="135dp"
            android:background="#38A55A" />


        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="20dp"
            android:background="#C3B1E1"
            android:padding="20dp"
            android:paddingTop="15dp"
            android:paddingBottom="15dp"
            android:text="Piękny Różowy\n Obraz"
            android:textColor="@android:color/black"
            android:textSize="24sp"
            android:textStyle="bold"
            android:gravity="center"
            />

    </FrameLayout>

</LinearLayout>
